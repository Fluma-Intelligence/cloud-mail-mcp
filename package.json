{
  "name": "@fluma/cloud-mail-mcp",
  "version": "0.1.0",
  "description": "MCP tools for cloud-mail mailboxes, messages, attachments and local drafts",
  "type": "module",
  "bin": { "cloud-mail-mcp": "dist/index.js" },
  "files": ["dist", "README.md", "LICENSE", "examples"],
  "engines": { "node": ">=22.16" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "tsx --test test/*.test.ts",
    "check": "npm run build && npm test",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/Fluma-Intelligence/cloud-mail-mcp.git" },
  "dependencies": { "@modelcontextprotocol/server": "2.3.1", "zod": "4.6.7" },
  "devDependencies": { "@modelcontextprotocol/client": "2.3.1", "@types/node": "^24.0.0", "tsx": "4.23.15", "typescript": "7.0.2" }
}
