MAIL_BASE_URL=https://mail.example.com
MAIL_EMAIL=agent@example.com
MAIL_PASSWORD=REPLACE_IN_YOUR_PRIVATE_ENV_FILE
# Alternative: a user JWT from /api/login (raw value)
# MAIL_TOKEN=
MAIL_ENABLE_WRITE=false
# Exact recipients, comma-separated. Empty allows any recipient permitted by the mailbox role.
MAIL_ALLOWED_RECIPIENTS=
# Default: ~/.local/state/cloud-mail-mcp
# MAIL_STATE_DIR=/absolute/private/directory/cloud-mail-mcp
MAIL_TIMEOUT_MS=15000
MAIL_MAX_ATTACHMENT_BYTES=1048576
